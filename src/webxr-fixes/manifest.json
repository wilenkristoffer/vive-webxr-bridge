{
    "name": "vive-webxr-bridge fixes",
    "version": "1.0",
    "description": "Works around WebXR requests that never start with VIVE's OpenXR runtime.",
    "manifest_version": 3,
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["xr-fixes.js"],
            "run_at": "document_start",
            "all_frames": true,
            "match_about_blank": true,
            "world": "MAIN"
        }
    ]
}
